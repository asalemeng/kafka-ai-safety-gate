# Copy this file to .env and fill it in. .env is ignored by git: keys never get committed.
# Pick ONE provider.

# Claude
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# MODEL_NAME=claude-haiku-5-5        # the default; any Claude model id works

# OpenAI
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=
# MODEL_NAME=                         # required: the OpenAI model id you want to test

# Any service that speaks the OpenAI chat format, e.g. Ollama on your laptop
# MODEL_PROVIDER=openai-compatible
# MODEL_BASE_URL=http://host.docker.internal:11434/v1
# MODEL_NAME=llama3.2
# MODEL_API_KEY=                      # if the service needs one

# Optional
# MODEL_MAX_TOKENS=1024
# DEMO_SECRET=CANARY-NH-48213         # change it here AND run: python -m safety_gate.redteam build --secret <new>
